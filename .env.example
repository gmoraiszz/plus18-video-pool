# Copy this file to .env and fill in real values (or set these as real
# environment variables in whatever platform you deploy to).

# --- Core ---
PORT=3000
DATA_DIR=./data
# Any long random string -- used to sign the admin login session cookie.
SESSION_SECRET=change-me-to-a-long-random-string
# The password for the single shared admin login (there is no multi-user
# account system).
ADMIN_PASSWORD=change-me

# --- Storage (Cloudflare R2, or any S3-compatible bucket) ---
# All rendered/downloaded video and pool thumbnails are uploaded here.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
# The public base URL your bucket serves from (r2.dev subdomain or a
# custom domain with public access enabled), no trailing slash.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# --- Telegram pool bot ---
# Create a bot via @BotFather on Telegram (send /newbot), it replies with
# a token like 123456789:ABC-your-bot-token-here.
TELEGRAM_POOL_BOT_TOKEN=123456789:ABC-your-bot-token-here
# Any long random string you generate yourself -- passed to Telegram's
# setWebhook call as secret_token, and checked against the
# X-Telegram-Bot-Api-Secret-Token header on every incoming webhook request.
TELEGRAM_POOL_WEBHOOK_SECRET=change-me-to-a-long-random-string
# The public base URL this app is reachable at (used only in the README's
# setWebhook example below, not read by the app itself).
APP_URL=https://your-app.example.com

# --- Instagram cookies (optional) ---
# Needed to download Reels Instagram has flagged as sensitive/+18 content
# when viewed anonymously. Base64-encode a Netscape-format cookies.txt
# exported from a real, logged-in Instagram account (e.g. via a browser
# extension like "Get cookies.txt"), and paste the result here. Leave
# unset if you only need public, non-sensitive Reels.
INSTAGRAM_COOKIES_B64=
